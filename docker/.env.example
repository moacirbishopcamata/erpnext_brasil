# Copie para docker/.env e ajuste. Este arquivo NÃO tem segredo: as senhas ficam em arquivos
# (docker/segredos/), criados por `python docker/preparar.py`, e entram nos contêineres por Docker secrets.

# Separador de arquivos do Compose fixado em vírgula: o mesmo COMPOSE_FILE vale em Windows e em Linux.
COMPOSE_PATH_SEPARATOR=,
# Banco de dados (a escolha é do Cherry): compose.mariadb.yaml ou compose.postgres.yaml.
COMPOSE_FILE=compose.yaml,compose.mariadb.yaml

# Nome do projeto. Para uma instância do Soda, use um nome derivado do UUID (por exemplo erp-1f3c9e2b).
COMPOSE_PROJECT_NAME=erpnext-brasil

# Imagem construída por `python docker/construir.py`.
IMAGEM=erpnext-brasil
TAG=version-16

# Site criado por `docker compose --profile inicializacao run --rm create-site`.
SITE_NAME=erp.localhost

# Rede: por padrão só o computador local. Para expor, defina ENDERECO=0.0.0.0 e proteja a máquina.
ENDERECO=127.0.0.1
PORTA_WEB=8080

# Versões de terceiros (as que o frappe_docker testa em 2026-10-11).
MARIADB_VERSION=11.8
POSTGRES_VERSION=15.17
REDIS_VERSION=8.6-alpine

# Desempenho da aplicação.
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120

# Identidade da instância (preenchida pelo Soda; opcional).
SODA_INSTANCE_ID=
SODA_DESCRITIVO=
